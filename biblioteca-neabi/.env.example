PORT=3000
NODE_ENV=development

# Endereço publicado do site oficial do NEABI, sem caminho de página.
# Enquanto estiver vazio, a interface usa o repositório como referência.
SITE_MAE_URL=

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=biblioteca_neabi
PG_USER=postgres
PG_PASSWORD=postgres
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/biblioteca_neabi

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/biblioteca_neabi

# Inicialização
DB_SYNC=false
REQUIRE_DATABASES=false
PG_CONNECT_TIMEOUT=5000
MONGO_CONNECT_TIMEOUT=5000
